# Example of exposing Caddy + AegisGate to the public internet
#
# Architecture: client → https://api.example.com/v1/__gw__/t/8317/... → Caddy → AegisGate:18080 → localhost:8317
#
# Pick the reverse_proxy target to match your deployment:
#   - Caddy and the gateway on the same docker compose network: aegisgate:18080 (Docker service-name resolution)
#   - Caddy on the host, gateway in Docker: 127.0.0.1:18080 (compose already maps the port)
#   - Caddy and the gateway both on the host: 127.0.0.1:18080
#   - Caddy on another machine: <gateway-machine-IP>:18080
#
# Key points:
#   - flush_interval -1: required, so SSE streams are not buffered
#   - response_header_timeout 660s: long inference runs must not time out
#   - /__gw__/* returns 403: the admin API is never exposed publicly
#   - X-Aegis-Proxy-Token: the Caddy ↔ AegisGate trust credential (optional). Once enabled, the gateway
#     accepts non-token /v1/... and /v2/... from Caddy regardless of client IP and routes them to
#     AEGIS_UPSTREAM_BASE_URL — i.e. it lifts the internal-only restriction, so guard the key accordingly.
#     For container deployments, scripts/caddy-entrypoint.sh reads config/aegis_proxy_token.key from the
#     shared config volume and exports it as AEGIS_PROXY_TOKEN before starting Caddy.
#   - Give the admin console its own domain pointing straight at the upstream, bypassing the gateway
#   - Caddy only does TLS + forwarding; all routing logic lives inside the gateway
#
# Ports 80/443 must be open; Caddy requests the certificate automatically

# Static frontend site (optional, unrelated to the gateway; delete the whole block if unused)
# example.com, www.example.com {
#     header {
#         X-Content-Type-Options "nosniff"
#         X-Frame-Options "SAMEORIGIN"
#         Referrer-Policy "strict-origin-when-cross-origin"
#         Permissions-Policy "geolocation=(), microphone=(), camera=()"
#         -Server
#     }
#     header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
#     root * /srv/www
#     file_server
# }

# API: inspected and filtered by AegisGate first, then forwarded upstream by the gateway
# Fill in the reverse_proxy target for your deployment (see the notes at the top of this file)
api.example.com {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
    # The admin endpoints stay off the public internet, so /__gw__ admin operations cannot be triggered through the proxy
    @gw_admin path /__gw__ /__gw__/*
    respond @gw_admin "forbidden" 403

    # Absorb the static-asset paths scanners probe instead of forwarding them to the gateway (less log noise)
    @scanner_probe {
        path /assets/* /static/* /js/* /css/* /images/* /img/* /fonts/*
        path /robots.txt /favicon.ico /sitemap.xml /.env /wp-login.php /wp-admin/*
        path /.git/* /.svn/* /.DS_Store /server-status /server-info
        path /phpmyadmin/* /pma/* /admin/* /administrator/* /cgi-bin/*
    }
    respond @scanner_probe 404

    # Allow only the API paths (/v1/, /v2/) through; every other path returns 404
    @not_api {
        not path /v1/* /v2/*
    }
    respond @not_api 404

    # Use 127.0.0.1:18080 when Caddy runs on the host (see the notes at the top of this file)
    # Also set AEGIS_TRUSTED_PROXY_IPS=127.0.0.1 on the gateway so X-Forwarded-For from this
    # proxy is trusted. With the default AEGIS_XFF_STRICT_INTERNAL=true, an empty trusted-proxy
    # list makes any XFF look like a public client (admin / default /v1 / UI).
    reverse_proxy 127.0.0.1:18080 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
        # Caddy ↔ AegisGate trust credential (optional)
        # The value comes from config/aegis_proxy_token.key (generated on first start)
        # To enable: set the AEGIS_PROXY_TOKEN environment variable for Caddy, then uncomment the line below
        # header_up X-Aegis-Proxy-Token {env.AEGIS_PROXY_TOKEN}
        flush_interval -1
        transport http {
            response_header_timeout 660s
            read_timeout 660s
            write_timeout 660s
        }
    }
}

# Upstream admin console (optional): connects straight to the upstream, bypassing the gateway.
# Replace with your real upstream address and port (CLIProxyAPI=8317, Sub2API=8080, AIClient-2-API=3000).
# In production, add an IP allowlist to restrict public access.
# panel.example.com {
#     @allowed remote_ip <your-admin-IP>/32
#     handle @allowed {
#         reverse_proxy localhost:8317 {
#             flush_interval -1
#             transport http {
#                 response_header_timeout 660s
#                 read_timeout 660s
#                 write_timeout 660s
#             }
#         }
#     }
#     respond "forbidden" 403
# }
