{
  "_description": "Multi-upstream token pre-configuration template. Save it as gw_tokens.json and the gateway loads it on restart.",
  "_format": "Each key is a custom token name; clients reach the matching upstream through /v1/__gw__/t/<token>/... .",
  "_compat_notes": [
    "With compat=openai_chat set, /v1/messages requests are converted to the /v1/responses format automatically.",
    "Model mapping is managed globally in config/model_map.json and is not bound to a specific token.",
    "default_model is optional and overrides the fallback model used when the global map has no hit (default gpt-5.4).",
    "Allowed target models: gpt-5, gpt-5.2, gpt-5.4, gpt-5.4-mini, gpt-5.2-codex, gpt-5.3-codex"
  ],
  "tokens": {
    "sub2api": {
      "upstream_base": "http://sub2api:8080/v1",
      "whitelist_key": []
    },
    "aiclient": {
      "upstream_base": "http://aiclient2api:3000/v1",
      "whitelist_key": []
    },
    "my-openai": {
      "upstream_base": "https://api.openai.com/v1",
      "whitelist_key": []
    },
    "claude-to-gpt": {
      "upstream_base": "https://api.openai.com/v1",
      "compat": "openai_chat"
    },
    "claude-to-gpt-codex": {
      "_description": "Sets default_model to override the gpt-5.4 default",
      "upstream_base": "https://api.openai.com/v1",
      "compat": "openai_chat",
      "default_model": "gpt-5.3-codex"
    }
  }
}
