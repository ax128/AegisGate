# AegisGate tunables (copy to .env and edit).
# Most values are picked up by the config watcher without a restart. The 12 security-critical
# ones are pinned at startup (hot_reload._IMMUTABLE_FIELDS) and need a restart — the full list is
# in config/README.md under "热更新说明". When in doubt, restart.
# Variable names are listed in the README "Configuration" section, all prefixed with AEGIS_

# ─── Listen address ─────────────────────────────────────────────────
# Bare metal only. The Docker image always binds 0.0.0.0 (the container's network
# boundary is the published port mapping), but it does read AEGIS_PORT — change the
# compose ports:/expose: entries to match when you change it.
AEGIS_HOST=127.0.0.1
AEGIS_PORT=18080
# Single process only. Statistics, rate-limit windows, the in-memory nonce replay
# cache and the compiled-rule caches are per-process singletons; more than one
# worker splits them silently. The gateway logs an ERROR when it detects
# WEB_CONCURRENCY / --workers > 1, and /health reports pid + instance.

# ─── Logging and runtime ────────────────────────────────────────────
AEGIS_LOG_LEVEL=info
# Whether DEBUG logs the full request body (default false: only method/path/route/headers + body_size)
AEGIS_LOG_FULL_REQUEST_BODY=false
AEGIS_ENV=prod
# Cosmetic; appears in logs and the console header only.
# AEGIS_APP_NAME=AegisGate

# ─── Security level and gateway ──────────────────────────────────────────
# low: very relaxed, essentially redaction only | medium (default): relaxed, high-risk hits + redaction | high: full detection
AEGIS_SECURITY_LEVEL=medium
# Block outright once a force-block command rule matches (independent of the security_level threshold)
AEGIS_STRICT_COMMAND_BLOCK_ENABLED=false
# [DEPRECATED] The yes/no approval flow was removed; whatever this is set to, a block masks or
# splits the dangerous fragment and returns it. Kept only for config compatibility.
# AEGIS_REQUIRE_CONFIRMATION_ON_BLOCK=false
# The gateway key is loaded from config/aegis_gateway.key, generated on first start (chmod 600)
# Read the key with: cat config/aegis_gateway.key
# Docker/CI can override the file with this variable: AEGIS_GATEWAY_KEY=<your-key>
AEGIS_DEFAULT_POLICY=default
# Comma-separated trusted reverse-proxy IPs (CIDR such as 172.16.0.0/12 is supported); only XFF from
# these IPs is trusted.
# Empty = trust the direct client IP only (safest default).
# Behind Caddy on the same host, set this to 127.0.0.1 so X-Forwarded-For is trusted.
AEGIS_TRUSTED_PROXY_IPS=
# Treat XFF from an untrusted direct peer as public (default). Set false only as a
# short-lived rollback while rolling out TRUSTED_PROXY_IPS. Restart required.
# Clearing TRUSTED_PROXY_IPS also requires a restart; XFF_STRICT_INTERNAL=false does
# not undo trusted-proxy effects on client IP / rate-limit keys.
AEGIS_XFF_STRICT_INTERNAL=true
# Allow local access only (loopback); a Docker deployment must set this to false (compose already does)
AEGIS_ENFORCE_LOOPBACK_ONLY=true
# Leave empty to generate a Fernet key into config/aegis_fernet.key automatically
# AEGIS_ENCRYPTION_KEY=
# Global risk score threshold (0-1); the lower it is, the more easily a block triggers.
# A policy YAML that declares risk_threshold overrides this, and all three shipped policies do
# (default/permissive 0.85, strict 0.50) — so this only applies to a policy that omits the key.
# The resolved value is then scaled by AEGIS_SECURITY_LEVEL and clamped to 1.0; see config/README.md.
AEGIS_RISK_SCORE_THRESHOLD=0.7

# ─── HMAC request signing (strongly recommended in production) ─────────────────────────
# Once enabled, every request must carry an HMAC-SHA256 signature, which blocks replay attacks and
# unauthorized calls.
# In production (AEGIS_ENV=prod) the startup log shows a security warning while it is disabled.
# AEGIS_ENABLE_REQUEST_HMAC_AUTH=false
# Signing secret (required once enabled; use at least 32 random bytes)
# AEGIS_REQUEST_HMAC_SECRET=<your-strong-secret-here>
# AEGIS_REQUEST_SIGNATURE_HEADER=x-aegis-signature
# AEGIS_REQUEST_TIMESTAMP_HEADER=x-aegis-timestamp
# AEGIS_REQUEST_NONCE_HEADER=x-aegis-nonce
# AEGIS_REQUEST_REPLAY_WINDOW_SECONDS=300
# Where seen nonces are kept. "memory" is per-process: with more than one worker
# or instance each keeps its own set, so a replayed request only has to reach a
# different one to be accepted. Use "redis" for anything beyond a single process.
# AEGIS_NONCE_CACHE_BACKEND=memory

# ─── UI sessions ──────────────────────────────────────────────
AEGIS_LOCAL_UI_SESSION_TTL_SECONDS=43200
AEGIS_LOCAL_UI_LOGIN_RATE_LIMIT_PER_MINUTE=10
AEGIS_LOCAL_UI_SECURE_COOKIE=true
AEGIS_LOCAL_UI_ALLOW_INTERNAL_NETWORK=false

# ─── Upstreams and rate limiting ──────────────────────────────────────────────
# Default v1 upstream (once set, only localhost/internal clients may call /v1/... directly; public
# callers should use the token path)
# AEGIS_UPSTREAM_BASE_URL=http://localhost:8317/v1
# Comma-separated upstream bases that bypass BOTH request and response
# pipelines, including PII redaction. Equivalent to __passthrough for those
# upstreams. Use only for fully trusted upstreams. Public clients do not get
# this bypass unless AEGIS_ALLOW_PUBLIC_UPSTREAM_WHITELIST=true.
AEGIS_UPSTREAM_WHITELIST_URL_LIST=
# Allow whitelist bypass from public/non-internal clients (default: internal-only).
AEGIS_ALLOW_PUBLIC_UPSTREAM_WHITELIST=false
AEGIS_UPSTREAM_TIMEOUT_SECONDS=600
AEGIS_UPSTREAM_MAX_CONNECTIONS=300
AEGIS_UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=100
# Retries for a streaming request that fails before the first chunk (only while no byte has been
# sent to the client).
# Default 0 (off); enabling it can make the upstream execute twice, so use it only where an
# idempotent retry is acceptable.
AEGIS_STREAM_BOOTSTRAP_RETRIES=0
AEGIS_FILTER_PIPELINE_TIMEOUT_S=90
# Action on a request-filter pipeline timeout: "block" (safe default) or "pass" (legacy behaviour)
AEGIS_REQUEST_PIPELINE_TIMEOUT_ACTION=block
AEGIS_MAX_REQUEST_BODY_BYTES=12000000
# Body limit for multipart/form-data requests (e.g. OpenAI /v1/images/edits, /v1/images/variations,
# /v1/files).
# OpenAI image edits require image+mask <50MB; the default here leaves some buffer.
AEGIS_MAX_MULTIPART_BODY_BYTES=60000000
AEGIS_MAX_MESSAGES_COUNT=500
AEGIS_MAX_CONTENT_LENGTH_PER_MESSAGE=250000
AEGIS_MAX_RESPONSE_LENGTH=2000000
# Admin endpoint rate limit: max requests per IP per minute
AEGIS_ADMIN_RATE_LIMIT_PER_MINUTE=30

# ─── Port routing and Docker upstreams ────────────────────────────────────
# Automatic local-port routing: a purely numeric token is forwarded to host.docker.internal:{port}/v1
# On by default for Docker deployments (compose sets it); bare-metal deployments must enable it manually
AEGIS_ENABLE_LOCAL_PORT_ROUTING=false
# Whether public/non-internal clients may use purely numeric tokens (1024-65535).
# Default false: numeric tokens are predictable, so keep them internal; public callers should use a
# random token (via register or a gw_tokens.json mapping).
AEGIS_ALLOW_PUBLIC_NUMERIC_TOKENS=false
# Use 127.0.0.1 for bare-metal deployments
AEGIS_LOCAL_PORT_ROUTING_HOST=host.docker.internal
# Whether public/non-internal clients may use token__passthrough to skip every security filter.
# Default false: passthrough disables all filters, so keep it to internal debugging.
AEGIS_ALLOW_PUBLIC_PASSTHROUGH_MODE=false
# Allowlist of ports permitted for compat port routing (claude-to-gpt/<port>... and similar).
# Comma-separated.
# Empty = compat port routing disabled (safe, fail-closed default).
# Example: AEGIS_COMPAT_ALLOWED_PORTS=8317,8080
AEGIS_COMPAT_ALLOWED_PORTS=
# Whether to auto-inject the built-in compat tokens (e.g. "claude-to-gpt"). Off by default; use it
# only for local or internal development.
AEGIS_ENABLE_BUILTIN_COMPAT_TOKENS=false
# Automatic Docker upstream injection: registers token → Docker service name at startup (a matching
# mapping takes precedence over port routing)
# Format: token:service[:port], comma-separated. An omitted port defaults to token.
# Example: 8317:cli-proxy-api,8080:sub2api,3000:aiclient2api
# To rename, repoint, or add an upstream: edit this variable and restart the gateway.
# AEGIS_DOCKER_UPSTREAMS=8317:cli-proxy-api,8080:sub2api,3000:aiclient2api

# Relay compatibility endpoint (off by default; enabling it exposes POST /relay/generate, and callers
# must still supply the internal x-upstream-base/gateway-key headers)
# AEGIS_ENABLE_RELAY_ENDPOINT=false

# ─── v2 proxy (generic HTTP/HTTPS forwarding) ──────────────────────────────
AEGIS_ENABLE_V2_PROXY=true
AEGIS_V2_ENABLE_REQUEST_REDACTION=true
AEGIS_V2_ENABLE_RESPONSE_COMMAND_FILTER=true
# true: enable minimal-false-block mode (protocol-level high-risk HTTP message signatures only:
# smuggling / response splitting / message obfuscation)
AEGIS_V2_RESPONSE_FILTER_OBVIOUS_ONLY=true
# Empty = reject every external target (safe, fail-closed default); production must configure the
# trusted domains explicitly
# Comma-separated; supports example.com / .example.com / *.example.com
# Example: AEGIS_V2_TARGET_ALLOWLIST=api.openai.com,.anthropic.com
AEGIS_V2_TARGET_ALLOWLIST=
# Comma-separated; supports example.com / .example.com / *.example.com
AEGIS_V2_RESPONSE_FILTER_BYPASS_HOSTS=
AEGIS_V2_RESPONSE_FILTER_MAX_CHARS=200000
AEGIS_V2_SSE_FILTER_PROBE_MAX_CHARS=4000
# Block v2 proxy requests to internal/private IPs (SSRF protection)
AEGIS_V2_BLOCK_INTERNAL_TARGETS=true
# v2 token routes carry multimodal payloads that exceed the v1 JSON body limit, so they get
# their own ceiling.
AEGIS_V2_MAX_REQUEST_BODY_BYTES=64000000

# ─── Semantic re-check (gray-zone gate; calls the semantic service; with no URL configured a gray-zone hit only records semantic_service_unconfigured) ───
AEGIS_ENABLE_SEMANTIC_MODULE=true
# The semantic re-check triggers only when the risk score falls inside
# (AEGIS_SEMANTIC_GRAY_LOW, AEGIS_SEMANTIC_GRAY_HIGH).
# When empty: a gray-zone hit records semantic_service_unconfigured and degrades (no semantic risk
# increase, no external request); it does not fall back to the in-repo TF-IDF resources.
AEGIS_SEMANTIC_SERVICE_URL=
AEGIS_SEMANTIC_GRAY_LOW=0.25
AEGIS_SEMANTIC_GRAY_HIGH=0.75
AEGIS_SEMANTIC_TIMEOUT_MS=150
AEGIS_SEMANTIC_CACHE_TTL_SECONDS=300
AEGIS_SEMANTIC_CIRCUIT_FAILURE_THRESHOLD=3
AEGIS_SEMANTIC_CIRCUIT_OPEN_SECONDS=30

# ─── Filter switches (values below are the built-in defaults; turn off as needed) ───────
# A filter runs only when its policy YAML lists it in enabled_filters AND the switch here is on.
# system_prompt_guard and untrusted_content_guard are absent from default.yaml, so they stay off
# regardless of these switches until you add them to the policy.
# AEGIS_ENABLE_REDACTION=true
# AEGIS_ENABLE_EXACT_VALUE_REDACTION=true
# AEGIS_ENABLE_RESTORATION=true
# AEGIS_ENABLE_INJECTION_DETECTOR=true
# AEGIS_ENABLE_PRIVILEGE_GUARD=true
# AEGIS_ENABLE_ANOMALY_DETECTOR=true
# AEGIS_ENABLE_REQUEST_SANITIZER=true
# AEGIS_ENABLE_OUTPUT_SANITIZER=true
# AEGIS_ENABLE_POST_RESTORE_GUARD=true
# AEGIS_ENABLE_SYSTEM_PROMPT_GUARD=false
# AEGIS_ENABLE_UNTRUSTED_CONTENT_GUARD=true
# AEGIS_ENABLE_TOOL_CALL_GUARD=true
# AEGIS_ENABLE_RAG_POISON_GUARD=true

# ─── Storage backend ──────────────────────────────────────────────
AEGIS_STORAGE_BACKEND=sqlite
# Behaviour when the storage backend fails: block = reject the request (safe default),
# forward = skip persisting mapping/audit records only; filter verdicts stay in force.
# Unregistered request filters still fail closed.
AEGIS_STORAGE_FAILURE_ACTION=block
AEGIS_SQLITE_DB_PATH=logs/aegisgate.db
# Interval (seconds) between periodic SQLite mapping_store cleanups, which delete mappings older
# than pending_data_ttl_seconds
AEGIS_MAPPING_PRUNE_INTERVAL_SECONDS=3600
AEGIS_AUDIT_LOG_PATH=logs/audit.jsonl
AEGIS_ENABLE_DANGEROUS_RESPONSE_LOG=false
# The file actually written is named dangerous_response_samples-YYYY-MM-DD.jsonl, and files older
# than 10 days are pruned automatically
AEGIS_DANGEROUS_RESPONSE_LOG_PATH=logs/dangerous_response_samples.jsonl
# Keep the matched text in those samples instead of only a sha256 + length. Only consulted when
# AEGIS_ENABLE_DANGEROUS_RESPONSE_LOG is already true, so turning the log on never by itself
# starts storing secrets. Turn it on only for a deliberate calibration window — the samples are
# credential paths and URLs with keys in them, and scripts/replay_calibrate.py has nothing to
# replay while it is off.
AEGIS_DANGEROUS_RESPONSE_LOG_INCLUDE_RAW=false
# AEGIS_REDIS_URL=redis://127.0.0.1:6379/0
# AEGIS_REDIS_KEY_PREFIX=aegisgate
# AEGIS_POSTGRES_DSN=postgresql://<user>:<password>@127.0.0.1:5432/aegisgate
# AEGIS_POSTGRES_SCHEMA=public

# ─── Data retention ───────────────────────────────────────────────
# How long a redaction mapping stays restorable. A response arriving after this
# window can no longer have its placeholders resolved, so keep it comfortably
# longer than your slowest conversation. Default 86400 (24h).
# AEGIS_PENDING_DATA_TTL_SECONDS=86400
# The background task that deletes mappings past that TTL. Turning it off means
# the mapping store grows without bound.
# AEGIS_ENABLE_MAPPING_PRUNE_TASK=true

# ─── File paths ───────────────────────────────────────────────────
# Relative paths resolve against the working directory. AEGIS_CONFIG_DIR (read
# straight from the environment, not from this file) overrides where runtime
# secrets live: the Fernet key, the exact-value store, and the keys the console's
# key-management page reads and rotates.
# AEGIS_GW_TOKENS_PATH=config/gw_tokens.json
# AEGIS_SECURITY_RULES_PATH=aegisgate/policies/rules/security_filters.yaml
# Startup-only, not hot-reloaded — restart after editing the file it points at.
# AEGIS_COMPAT_MODEL_MAP_PATH=config/model_map.json
# Directory the console's Compose editor may read and write. Empty = the app root.
# AEGIS_COMPOSE_DIR=

# ─── Header names (rename only if they collide with your infrastructure) ───
# AEGIS_GATEWAY_KEY_HEADER=gateway-key
# AEGIS_UPSTREAM_BASE_HEADER=x-upstream-base

# ─── Cache sizing ─────────────────────────────────────────────────
# In-process only, so these are per-worker. See the single-process note at the top.
# AEGIS_REQUEST_NONCE_CACHE_SIZE=50000
# AEGIS_SEMANTIC_CACHE_MAX_ENTRIES=5000

# ─── Block notifications ──────────────────────────────────────────
# Whether a block notice includes a preview of the matched fragment (already
# obfuscated). Set false to keep matched text out of client-visible copy.
# AEGIS_CONFIRMATION_SHOW_HIT_PREVIEW=true
